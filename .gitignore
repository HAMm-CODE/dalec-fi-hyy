# --- Data -------------------------------------------------------------------
# The FLUXNET2015 csv is redistributable only under the FLUXNET data policy,
# and the processed arrays are reproducible from it, so neither is tracked.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- Results ----------------------------------------------------------------
# Traces, figures and tables are regenerated by the scripts.
results/*
!results/.gitkeep

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# --- Tooling ----------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- PyTensor ---------------------------------------------------------------
.pytensor/
compiledir_*/

# --- Notebooks --------------------------------------------------------------
.ipynb_checkpoints/

# --- Cluster ----------------------------------------------------------------
slurm-*.out
*.err

# --- Editors / OS -----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
